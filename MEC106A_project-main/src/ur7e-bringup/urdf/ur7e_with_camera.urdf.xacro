<?xml version="1.0"?>
<!--
  UR7e URDF with RealSense D435 camera mounted on end-effector.
  Extend this file to add your specific tool/gripper.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ur7e_with_camera">

  <!-- Include the standard UR7e description -->
  <xacro:include filename="$(find ur_description)/urdf/ur.urdf.xacro"/>

  <!-- UR7e parameters -->
  <xacro:ur_robot
    name="ur7e"
    tf_prefix=""
    parent="world"
    joint_limits_parameters_file="$(find ur_description)/config/ur7e/joint_limits.yaml"
    kinematics_parameters_file="$(find ur_description)/config/ur7e/default_kinematics.yaml"
    physical_parameters_file="$(find ur_description)/config/ur7e/physical_parameters.yaml"
    visual_parameters_file="$(find ur_description)/config/ur7e/visual_parameters.yaml">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:ur_robot>

  <!-- World link -->
  <link name="world"/>

  <!-- ── Camera mount ─────────────────────────────────────────────────── -->
  <!-- A simple bracket that attaches the RealSense to the tool0 flange.  -->
  <!-- Adjust the xyz/rpy offsets to match your physical mount.           -->
  <link name="camera_mount_link">
    <visual>
      <geometry>
        <box size="0.05 0.03 0.02"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.3 0.3 0.3 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.05 0.03 0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="camera_mount_joint" type="fixed">
    <parent link="tool0"/>
    <child link="camera_mount_link"/>
    <!-- Offset: 5cm forward, camera center aligned with tool -->
    <origin xyz="0.05 0 0.01" rpy="0 0 0"/>
  </joint>

  <!-- Camera optical frame (matches RealSense convention) -->
  <link name="camera_color_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_mount_link"/>
    <child link="camera_color_optical_frame"/>
    <!-- RealSense frame convention: z forward, x right, y down -->
    <origin xyz="0 0 0" rpy="-1.5707 0 -1.5707"/>
  </joint>

</robot>
