<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ur_board_detection</name>
  <version>0.1.0</version>
  <description>
    ROS2 detection package for the Operation board game using a UR7e robot
    arm and RealSense D435i camera.  Detects yellow game pieces, green grasp
    stubs, and board cavities; publishes 3-D grasp targets for the motion
    planning layer.
  </description>
  <maintainer email="kishantm2004@gmail.com">kishantm1</maintainer>
  <license>MIT</license>

  <!-- Build tools -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <!-- Runtime deps shared by both build and exec -->
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <!-- Required so the generated Python service bindings are available at runtime -->
  <exec_depend>rosidl_default_runtime</exec_depend>

  <!-- Marks this package as one that exports ROS interfaces -->
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
